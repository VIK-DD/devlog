#!/usr/bin/env bash
set -euo pipefail
umask 022

app=/opt/devlog
releases=$app/releases
current=$app/current
fallback=$app/previous
state=$STATE_DIRECTORY
cache=$state/repo.git
remote=git@github.com:VIK-DD/devlog.git
export GIT_SSH_COMMAND="/usr/bin/ssh -F /dev/null -i $CREDENTIALS_DIRECTORY/deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$CREDENTIALS_DIRECTORY/github_known_hosts -o BatchMode=yes -o ConnectTimeout=10"

point() {
  local target=$1 link=$2
  ln -sfn -- "$target" "$link.next"
  mv -Tf -- "$link.next" "$link"
}

healthy() {
  local target=$1 pid cwd i
  for (( i=0; i<12; i++ )); do
    pid=$(systemctl show -p MainPID --value devlog.service)
    cwd=$(readlink "/proc/$pid/cwd" || true)
    if [[ $cwd = "$target" ]] &&
      [[ $(curl -fsS --max-time 2 http://127.0.0.1:8310/healthz 2>/dev/null) = ok ]]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

install_release() {
  local tree entry path staged
  local -a modes=()
  tree=$(git -C "$cache" ls-tree -r "$sha" -- package.json src) || return 1
  mapfile -t modes < <(printf '%s\n' "$tree" | cut -d' ' -f1 | sort -u)
  for entry in "${modes[@]}"; do
    [[ $entry = 100644 || $entry = 100755 ]] || return 1
  done
  staged=$(mktemp -d "$releases/.stage.XXXXXX") || return 1
  if (
    set -euo pipefail
    git -C "$cache" archive "$sha" -- package.json src |
      tar -x --no-same-owner --no-same-permissions -C "$staged" || exit 1
    test -f "$staged/package.json" && test -f "$staged/src/server.js" || exit 1
    while IFS= read -r -d '' path; do
      /usr/bin/node --check "$path" || exit 1
    done < <(find "$staged/src" -type f \( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \) -print0)
    chmod 0755 "$staged" && mv -T -- "$staged" "$target"
  ); then
    return 0
  fi
  rm -rf -- "$staged"
  return 1
}

read -r sha _ < <(git ls-remote --exit-code "$remote" refs/heads/main)
[[ $sha =~ ^[0-9a-f]{40}$ ]]
previous=$(readlink "$current")
if [[ $previous = "$releases/$sha" ]] && healthy "$previous"; then
  exit 0
fi
if [[ -f $state/rejected && $(< "$state/rejected") = "$sha" ]]; then
  exit 0
fi

[[ -d $cache ]] || git init -q --bare "$cache"
git -C "$cache" fetch -q --no-tags --depth=1 "$remote" refs/heads/main
sha=$(git -C "$cache" rev-parse --verify 'FETCH_HEAD^{commit}')
[[ $sha =~ ^[0-9a-f]{40}$ ]]
target=$releases/$sha
if [[ ! -d $target ]] && ! install_release; then
  printf '%s\n' "$sha" > "$state/rejected"
  echo "Validation failed for $sha. The current release is still active." >&2
  exit 1
fi

if [[ $previous = "$target" ]]; then
  previous=$(readlink "$fallback")
else
  point "$previous" "$fallback"
fi
point "$target" "$current"
if systemctl restart devlog.service && healthy "$target"; then
  echo "Deployed $sha"
  for release in "$releases"/[0-9a-f]*; do
    [[ -d $release && $release != "$target" && $release != "$previous" ]] || continue
    rm -rf -- "$release"
  done
  exit 0
fi

point "$previous" "$current"
systemctl restart devlog.service
healthy "$previous"
printf '%s\n' "$sha" > "$state/rejected"
echo "Health check failed for $sha. Rolled back to $previous." >&2
exit 1
